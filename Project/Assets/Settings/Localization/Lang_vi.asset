  m_TableData:
  - m_Id: 3314955647
    m_Localized: "K\u00edch ho\u1ea1t thi\u1ebft b\u1ecb"
    m_Metadata:
      m_Items: []
  - m_Id: 2492018094
    m_Localized: "M\u00e3 k\u00edch ho\u1ea1t \u0111\u00e3 \u0111\u01b0\u1ee3c sao ch\u00e9p. B\u1ea5m v\u00e0o li\u00ean k\u1ebft b\u00ean d\u01b0\u1edbi \u0111\u1ec3 k\u00edch ho\u1ea1t thi\u1ebft b\u1ecb."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955648
    m_Localized: "K\u00edch ho\u1ea1t th\u1ea5t b\u1ea1i. Vui l\u00f2ng th\u1eed kh\u1edfi \u0111\u1ed9ng l\u1ea1i \u1ee9ng d\u1ee5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955649
    m_Localized: "\u0110ang t\u1ea3i t\u00e0i nguy\u00ean..."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955650
    m_Localized: "\u0110ang t\u1ea3i m\u00f4 h\u00ecnh..."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955651
    m_Localized: "\u0110ang kh\u1edfi \u0111\u1ed9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955652
    m_Localized: "Ch\u1edd"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955653
    m_Localized: "\u0110ang k\u1ebft n\u1ed1i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955654
    m_Localized: "\u0110ang l\u1eafng nghe"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955655
    m_Localized: "\u0110ang n\u00f3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955656
    m_Localized: "L\u1ed7i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955657
    m_Localized: "Kh\u00f4ng t\u00ecm th\u1ea5y micro."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955658
    m_Localized: "C\u00e0i \u0111\u1eb7t"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955659
    m_Localized: "Thay \u0111\u1ed5i \u0111\u00e3 \u00e1p d\u1ee5ng. S\u1ebd c\u00f3 hi\u1ec7u l\u1ef1c sau khi kh\u1edfi \u0111\u1ed9ng l\u1ea1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955660
    m_Localized: "URL kh\u00f4ng h\u1ee3p l\u1ec7. Vui l\u00f2ng th\u1eed l\u1ea1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955661
    m_Localized: "\u0110\u1ecba ch\u1ec9 MAC kh\u00f4ng h\u1ee3p l\u1ec7. Vui l\u00f2ng th\u1eed l\u1ea1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955662
    m_Localized: "Vui l\u00f2ng nh\u1eadp {0}"
    m_Metadata:
      m_Items:
      - rid: 8193056366595407875
  - m_Id: 3314955663
    m_Localized: OTA URL
    m_Metadata:
      m_Items: []
