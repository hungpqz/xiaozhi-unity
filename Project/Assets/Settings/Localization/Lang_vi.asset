  - m_Id: 3314955689
    m_Localized: "Y\u00eau c\u1ea7u quy\u1ec1n {0} th\u1ea5t b\u1ea1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955690
    m_Localized: "Y\u00eau c\u1ea7u quy\u1ec1n th\u1ea5t b\u1ea1i. Vui l\u00f2ng th\u1eed kh\u1edfi \u0111\u1ed9ng l\u1ea1i \u1ee9ng d\u1ee5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2159087987941376
    m_Localized: "XiaoZhi c\u1ea7n s\u1eed d\u1ee5ng camera c\u1ee7a b\u1ea1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159308025323520
    m_Localized: "XiaoZhi c\u1ea7n truy c\u1eadp v\u1ecb tr\u00ed c\u1ee7a b\u1ea1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159389092831232
    m_Localized: "XiaoZhi c\u1ea7n s\u1eed d\u1ee5ng micro \u0111\u1ec3 tr\u00f2 chuy\u1ec7n v\u1edbi b\u1ea1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159431325278208
    m_Localized: "XiaoZhi c\u1ea7n truy c\u1eadp m\u00e3 \u0111\u1ecbnh danh qu\u1ea3ng c\u00e1o c\u1ee7a b\u1ea1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2160026320855040
    m_Localized: "XiaoZhi Unity"
    m_Metadata:
      m_Items: []
  - m_Id: 2160154335207424
    m_Localized: "XiaoZhi Unity"
    m_Metadata:
      m_Items: []
  - m_Id: 7051894095568896
    m_Localized: "ID ng\u01b0\u1eddi d\u00f9ng/Email/S\u1ed1 \u0111i\u1ec7n tho\u1ea1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7900086924173312
    m_Localized: "M\u1eadt kh\u1ea9u"
    m_Metadata:
      m_Items: []
  - m_Id: 7052053349097472
