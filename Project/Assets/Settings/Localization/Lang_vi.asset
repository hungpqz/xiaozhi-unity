  m_TableData:
  - m_Id: 3314955647
    m_Localized: "K\xEDch ho\u1EA1t thi\u1EBFt b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 2492018094
    m_Localized: "M\xE3 k\xEDch ho\u1EA1t \u0111\xE3 \u0111\u01B0\u1EE3c sao ch\xE9p.
      B\u1EA5m v\xE0o li\xEAn k\u1EBFt b\xEAn d\u01B0\u1EDBi \u0111\u1EC3 k\xEDch
      ho\u1EA1t thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955648
    m_Localized: "K\xEDch ho\u1EA1t th\u1EA5t b\u1EA1i. Vui l\xF2ng th\u1EED kh\u1EDFi
      \u0111\u1ED9ng l\u1EA1i \u1EE9ng d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955649
    m_Localized: "\u0110ang t\u1EA3i t\xE0i nguy\xEAn..."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955650
    m_Localized: "\u0110ang t\u1EA3i m\xF4 h\xECnh..."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955651
    m_Localized: "\u0110ang kh\u1EDFi \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955652
    m_Localized: "Ch\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955653
    m_Localized: "\u0110ang k\u1EBFt n\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955654
    m_Localized: "\u0110ang l\u1EAFng nghe"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955655
    m_Localized: "\u0110ang n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955656
    m_Localized: "L\u1ED7i"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955657
    m_Localized: "Kh\xF4ng t\xECm th\u1EA5y micro."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955658
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955659
    m_Localized: "Thay \u0111\u1ED5i \u0111\xE3 \xE1p d\u1EE5ng. S\u1EBD c\xF3 hi\u1EC7u
      l\u1EF1c sau khi kh\u1EDFi \u0111\u1ED9ng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955660
    m_Localized: "URL kh\xF4ng h\u1EE3p l\u1EC7. Vui l\xF2ng th\u1EED l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955661
    m_Localized: "\u0110\u1ECBa ch\u1EC9 MAC kh\xF4ng h\u1EE3p l\u1EC7. Vui l\xF2ng
      th\u1EED l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955662
    m_Localized: "Vui l\xF2ng nh\u1EADp {0}"
    m_Metadata:
      m_Items:
      - rid: 8193056366595407875
  - m_Id: 3314955663
    m_Localized: OTA URL
    m_Metadata:
      m_Items: []
  - m_Id: 3314955664
    m_Localized: WebSocket URL
    m_Metadata:
      m_Items: []
  - m_Id: 3314955665
    m_Localized: WebSocket Access Token
    m_Metadata:
      m_Items: []
  - m_Id: 3314955666
    m_Localized: "\u0110\u1ECBa ch\u1EC9 MAC"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955667
    m_Localized: "Ch\u1EBF \u0111\u1ED9 hi\u1EC3n th\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 3314955668
    m_Localized: Emoji
    m_Metadata:
      m_Items: []
  - m_Id: 3314955669
