    m_Metadata:
      m_Items: []
  - m_Id: 3314955689
    m_Localized: "Y\xEAu c\u1EA7u quy\u1EC1n {0} th\u1EA5t b\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 3314955690
    m_Localized: "Y\xEAu c\u1EA7u quy\u1EC1n th\u1EA5t b\u1EA1i. Vui l\xF2ng th\u1EED
      kh\u1EDFi \u0111\u1ED9ng l\u1EA1i \u1EE9ng d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2159087987941376
    m_Localized: "BigWell c\u1EA7n s\u1EED d\u1EE5ng camera c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159308025323520
    m_Localized: "BigWell c\u1EA7n truy c\u1EADp v\u1ECB tr\xED c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159389092831232
    m_Localized: "BigWell c\u1EA7n s\u1EED d\u1EE5ng micro \u0111\u1EC3 tr\xF2 chuy\u1EC7n
      v\u1EDBi b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2159431325278208
    m_Localized: "BigWell c\u1EA7n truy c\u1EADp m\xE3 \u0111\u1ECBnh danh qu\u1EA3ng
      c\xE1o c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2160026320855040
    m_Localized: BigWell Unity
    m_Metadata:
      m_Items: []
  - m_Id: 2160154335207424
    m_Localized: BigWell Unity
    m_Metadata:
      m_Items: []
  - m_Id: 7051894095568896
    m_Localized: "ID ng\u01B0\u1EDDi d\xF9ng/Email/S\u1ED1 \u0111i\u1EC7n tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7900086924173312
    m_Localized: "M\u1EADt kh\u1EA9u"
    m_Metadata:
      m_Items: []
  - m_Id: 7052053349097472
    m_Localized: "\u0110\u0103ng nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 7052100107198464
    m_Localized: "\u0110\u0103ng xu\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 7052185847160832
    m_Localized: "\u0110\u0103ng nh\u1EADp th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7052351807381504
    m_Localized: "\u0110\u0103ng nh\u1EADp th\u1EA5t b\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7052665411297280
    m_Localized: "Nh\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 7052731333173248
    m_Localized: "Ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7052790267338752
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n b\u1EB1ng gi\u1ECDng n\xF3i c\xE1c thi\u1EBFt
      b\u1ECB IoT \u0111\xE3 ch\u1ECDn b\xEAn d\u01B0\u1EDBi, thay \u0111\u1ED5i
      s\u1EBD c\xF3 hi\u1EC7u l\u1EF1c sau khi kh\u1EDFi \u0111\u1ED9ng l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7053541869838336
    m_Localized: "L\xE0m m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 7053570470797312
    m_Localized: "B\u1ECF ch\u1ECDn t\u1EA5t c\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 7053948998344704
    m_Localized: "Thay \u0111\u1ED5i thu\u1ED9c t\xEDnh {0} th\u1EA5t b\u1EA1i: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 7054207824650240
    m_Localized: Chung
    m_Metadata:
      m_Items: []
  - m_Id: 7054277517205504
    m_Localized: MIoT
    m_Metadata:
      m_Items: []
  - m_Id: 7077900567142400
    m_Localized: "\u0110ang t\u1EA3i MIoT..."
    m_Metadata:
      m_Items: []
  - m_Id: 7889102125883392
    m_Localized: "M\xE3 x\xE1c minh"
    m_Metadata:
      m_Items: []
  - m_Id: 7889234766553088
    m_Localized: "\u0110\u0103ng nh\u1EADp c\u1EE5c b\u1ED9 c\u1EA7n x\xE1c minh
      \u0111i\u1EC7n tho\u1EA1i/email c\u1EE7a b\u1EA1n, <color=#FF6C37><u><link=\"0\">b\u1EA5m
      v\xE0o \u0111\xE2y \u0111\u1EC3 l\u1EA5y m\xE3 x\xE1c minh</link></u></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7889508973371392
    m_Localized: "X\xE1c minh"
    m_Metadata:
      m_Items: []
  - m_Id: 7895673413263360
    m_Localized: "Quay l\u1EA1i \u0111\u0103ng nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 7957408966991872
    m_Localized: "L\xE0m m\u1EDBi th\xE0nh c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 8675432594366464
    m_Localized: "K\u1EBFt n\u1ED1i \u0111\xE3 b\u1ECB \u0111\xF3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 49667773039599616
    m_Localized: "C\u1EA3nh xa"
    m_Metadata:
      m_Items: []
  - m_Id: 49667893739085824
    m_Localized: "C\u1EA3nh trung"
    m_Metadata:
      m_Items: []
  - m_Id: 49668220370509824
    m_Localized: "\u1ED0ng k\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 49667904732356608
