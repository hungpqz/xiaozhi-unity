    m_Metadata:
      m_Items: []
  - m_Id: 7077900567142400
    m_Localized: "\u0110ang t\u1ea3i MIoT..."
    m_Metadata:
      m_Items: []
  - m_Id: 7889102125883392
    m_Localized: "M\u00e3 x\u00e1c minh"
    m_Metadata:
      m_Items: []
  - m_Id: 7889234766553088
    m_Localized: "\u0110\u0103ng nh\u1eadp c\u1ee5c b\u1ed9 c\u1ea7n x\u00e1c minh \u0111i\u1ec7n tho\u1ea1i/email c\u1ee7a b\u1ea1n, <color=#FF6C37><u><link=\"0\">b\u1ea5m v\u00e0o \u0111\u00e2y \u0111\u1ec3 l\u1ea5y m\u00e3 x\u00e1c minh</link></u></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7889508973371392
