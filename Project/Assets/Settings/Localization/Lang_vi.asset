      m_Items: []
  - m_Id: 7052185847160832
    m_Localized: "\u0110\u0103ng nh\u1eadp th\u00e0nh c\u00f4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7052351807381504
    m_Localized: "\u0110\u0103ng nh\u1eadp th\u1ea5t b\u1ea1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7052665411297280
    m_Localized: "Nh\u00e0"
    m_Metadata:
      m_Items: []
  - m_Id: 7052731333173248
    m_Localized: "Ph\u00f2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7052790267338752
    m_Localized: "\u0110i\u1ec1u khi\u1ec3n b\u1eb1ng gi\u1ecdng n\u00f3i c\u00e1c thi\u1ebft b\u1ecb IoT \u0111\u00e3 ch\u1ecdn b\u00ean d\u01b0\u1edbi, thay \u0111\u1ed5i s\u1ebd c\u00f3 hi\u1ec7u l\u1ef1c sau khi kh\u1edfi \u0111\u1ed9ng l\u1ea1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7053541869838336
    m_Localized: "L\u00e0m m\u1edbi"
    m_Metadata:
      m_Items: []
  - m_Id: 7053570470797312
    m_Localized: "B\u1ecf ch\u1ecdn t\u1ea5t c\u1ea3"
    m_Metadata:
      m_Items: []
  - m_Id: 7053948998344704
    m_Localized: "Thay \u0111\u1ed5i thu\u1ed9c t\u00ednh {0} th\u1ea5t b\u1ea1i: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 7054207824650240
    m_Localized: "Chung"
    m_Metadata:
      m_Items: []
  - m_Id: 7054277517205504
